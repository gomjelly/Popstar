{
  "name": "popstar",
  "version": "0.1.0",
  "private": true,
  "description": "프로젝터와 카메라로 하는 아이들용 AR 체감 게임 모음",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "make:video": "npm run build && electron scripts/make-people-video.cjs",
    "setup:assets": "node scripts/setup-assets.mjs",
    "postinstall": "node scripts/setup-assets.mjs",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.2",
    "three": "^0.187.0"
  }
}
